DATABASE_URL=postgresql+asyncpg://phishstats:phishstats@db:5432/phishstats
SYNC_DATABASE_URL=postgresql://phishstats:phishstats@db:5432/phishstats
ENVIRONMENT=development
ECHO_SQL=false

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30
